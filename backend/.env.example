PROJECT_NAME=AuthFlow
ENVIRONMENT=development
DEBUG=true

# Must be set to a real random value outside ENVIRONMENT=development --
# the app refuses to start otherwise (see app/core/config.py).
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SSL is required for Neon (and most hosted Postgres) and enabled by
# default. The docker-compose local Postgres doesn't have TLS configured,
# so its api/migrate services override this to false -- leave it true here.
DB_SSL=true

# Postgres connection pool (only applies when DATABASE_URL is Postgres).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Hosted Postgres (Neon). Copy the connection string from your Neon project
# dashboard, switch its scheme to "postgresql+asyncpg", and drop the
# ?sslmode=require&channel_binding=require query params — asyncpg doesn't
# understand those; SSL is configured automatically in code instead
# (see app/db/session.py). Example, Neon gives you:
#   postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# which becomes:
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb

# Vite's default dev server runs on 5173, not 3000 -- both are listed since
# either is a reasonable choice for the frontend.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
